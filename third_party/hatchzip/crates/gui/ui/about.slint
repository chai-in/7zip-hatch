import { AboutSlint, Button, Palette } from "std-widgets.slint";
import { Theme, Line } from "theme.slint";

export component AboutWindow inherits Window {
    in property <string> version;
    callback open-link();
    callback dismiss();

    title: "About 7-Zip Hatch";
    preferred-width: 420px;
    min-width: 380px;
    background: Palette.background;

    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        alignment: start;

        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            Image {
                // Drawn on a 16 px grid, so 48 keeps every edge sharp.
                source: @image-url("../../../assets/icon/png/hatchzip-48.png");
                width: 48px;
                height: 48px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: "7-Zip Hatch";
                    font-size: 20px;
                    font-weight: 600;
                }
                Text {
                    text: "Version " + root.version;
                    color: Theme.muted;
                }
            }
        }
        Text {
            text: "Create, browse, test, and extract archives with 7-Zip. Optional space-saving extraction releases archive space as files are safely extracted.";
            wrap: word-wrap;
        }
        Text {
            text: "Desktop distribution: GPLv3. Includes 7-Zip and HatchZip; see bundled license notices.";
            color: Theme.muted;
            wrap: word-wrap;
        }
        link := Text {
            text: "github.com/chai-in/7zip-hatch";
            color: Palette.accent-background;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open-link();
                }
            }
        }
        Rectangle {
            height: 6px;
        }
        Line { }
        AboutSlint {
            max-height: 160px;
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
